config interface 'loopback'
    option device 'lo'
    option proto 'static'
    list ipaddr '127.0.0.1/8'

config globals 'globals'
    option ula_prefix 'fd54:519a:125c::/48'
    option packet_steering '1'

config device
    option name 'br-lan'
    option type 'bridge'
    list ports 'lan1'
    list ports 'lan2'
    list ports 'lan3'
    option igmp_snooping '1'

config interface 'lan'
    option device 'br-lan'
    option proto 'static'
    list ipaddr '192.168.1.1/24'
    option ip6assign '60'
    
config device 'dev_wan20'
    option name 'wan.20'
    option type '8021q'
    option ifname 'wan'
    option vid '20'

config interface 'wan'
    option device 'wan.20'
    option proto 'pppoe'
    option username 'ВАШЕИМЯПОЛЬЗОВАТЕЛЯ'
    option password 'ВАШПАРОЛЬ'
    option ipv6 'auto'
    option mtu '1492'
    option keepalive '5 10'
    option delegate '0'

config device 'dev_wan40'
    option name 'wan.40'
    option type '8021q'
    option ifname 'wan'
    option vid '40'

config interface 'iptv'
    option device 'wan.40'
    option proto 'none'
    option auto '1'

config device
    option name 'br-iptv'
    option type 'bridge'
    list ports 'lan4'
    option igmp_snooping '0'

config interface 'iptv_lan'
    option device 'br-iptv'
    option proto 'static'
    list ipaddr '192.168.100.1/24'
    option delegate '0'
